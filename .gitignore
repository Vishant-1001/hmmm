# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Data (raw/cached research data is downloaded, never committed)
data/raw/
data/cache/
data/interim/
*.zarr/
*.nc
*.grib
*.grib2

# Large model binaries are regenerated by the pipeline
models/*.ubj
models/*.pkl
models/*.joblib
!models/.gitkeep

# Secrets
.env
*.pem
*.key

# Node / frontend
node_modules/
# frontend/dist/ is committed: the Render web service serves the built UI (see docs/render_deploy.md).
# Rebuild with `cd frontend && npm run build` (no VITE_API_URL); tests/test_ui_bundle.py checks it is current.
frontend/.vite/

# OS / editors
.DS_Store
.idea/
.vscode/
*.swp
logs/
artifacts/dev/
models/dev/
data/interim/
artifacts/*/dev/*
!artifacts/v2/dev/optimization/
models/*/dev/
artifacts/v2a/
models/v2a/
models/*/*.joblib
