  "forecast_store": "gs://weatherbench2/datasets/ifs_ens/2018-2022-64x32_equiangular_conservative.zarr",
  "reference": "ERA5 (WeatherBench 2) - verification reference analysis, not perfect truth",
  "target": "Z500 ensemble-mean regional error",
